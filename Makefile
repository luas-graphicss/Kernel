REQUIRED_VARIABLES := \
	BUILD CROSS_COMPILE COMPILER_DIR MICROPYTHON_DIR KERNEL_BASE SUPERVISOR_STACK_BYTES \
	EMERGENCY_STACK_BYTES SUPERVISOR_HEAP_BYTES USER_REGION_BASE USER_REGION_BYTES \
	USER_HEAP_BYTES USER_STACK_BYTES PROFILE_MEMORY_BYTES PROFILE_PROCESSES \
	PROFILE_PROCESS_HEAP_BYTES PROFILE_CAPABILITIES_PER_PROCESS \
	PROFILE_IPC_PENDING_BYTES_PER_PROCESS PROFILE_IPC_PENDING_BYTES_GLOBAL
$(foreach name,$(REQUIRED_VARIABLES),$(if $($(name)),,$(error $(name) is not set; build with kernel-tool)))

.DEFAULT_GOAL := all

include native/native.mk
include ports/micropython/runtime.mk
include ports/micropython/user/image.mk

KERNEL := $(BUILD)/kernel.elf
KERNEL_LINKER_SCRIPT := native/arch/riscv64/boot/kernel.ld
KERNEL_LINK_FLAGS := \
	-m elf64lriscv -nostdlib --no-relax --gc-sections --build-id=none \
	-T $(KERNEL_LINKER_SCRIPT) \
	--defsym=KERNEL_BASE=$(KERNEL_BASE) \
	--defsym=SUPERVISOR_STACK_BYTES=$(SUPERVISOR_STACK_BYTES) \
	--defsym=EMERGENCY_STACK_BYTES=$(EMERGENCY_STACK_BYTES) \
	--defsym=SUPERVISOR_HEAP_BYTES=$(SUPERVISOR_HEAP_BYTES) \
	--defsym=USER_REGION_BASE=$(USER_REGION_BASE) \
	--defsym=USER_REGION_BYTES=$(USER_REGION_BYTES)
KERNEL_RUNTIME := $(SUPERVISOR_LIBRARY) $(LIBC_OBJECT)

link_kernel = $(CROSS_COMPILE)ld $(KERNEL_LINK_FLAGS) -Map=$@.map -o $@ $(1) $(KERNEL_RUNTIME) $(LIBGCC)

include tests/guest/guest.mk

.PHONY: all analyze
all: $(KERNEL) $(INIT_IMAGE) $(SELFTEST_KERNEL) $(FAULT_IMAGE) $(TESTS_IMAGE)

analyze: $(NATIVE_ANALYSIS)

$(KERNEL): $(NATIVE_OBJECTS) $(POLICY_FROZEN) $(KERNEL_RUNTIME) $(KERNEL_LINKER_SCRIPT)
	$(call link_kernel,$(NATIVE_OBJECTS) $(POLICY_FROZEN))
