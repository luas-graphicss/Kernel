def startup() -> tuple[str, bytes, tuple[int, ...], int]: ...
def call(number: int, first: int = 0, second: int = 0) -> int: ...
def send(endpoint: int, message: bytes, transfer: int, deadline: int) -> int: ...
def receive(endpoint: int, buffer: bytearray, deadline: int) -> tuple[int, int, int, int]: ...
def request(
    endpoint: int, message: bytes, response: bytearray, transfer: int, deadline: int
) -> tuple[int, int]: ...
def reply(reply: int, message: bytes, transfer: int) -> int: ...
def spawn(system: int, request: bytes) -> int: ...
def counters(system: int) -> tuple[int, ...] | int: ...
def buffer_map(handle: int, writable: bool) -> int: ...
def buffer_unmap(token: int) -> int: ...
def buffer_size(token: int) -> int: ...
def buffer_read(token: int, offset: int, length: int) -> bytes: ...
def buffer_write(token: int, offset: int, data: bytes) -> None: ...
